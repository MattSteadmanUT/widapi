{
  /*
    National WID 3.0 API — Dev deployment profile
    AWS profile: GovDev (us-gov-west-1)

    To deploy:  just deploy dev
    To validate: just validate-deploy dev

    The vpcId/vpcSubnetIds/vpcSecurityGroupIds/s3-bucket TODO_SET_YOUR_* values below were
    Utah's own live dev-environment resource IDs in the working copy this was cleaned up from.
    They were replaced with placeholders here because Utah's dev environment is still running --
    not because the values were ever meant to be reused. Fill in your own AWS account's VPC,
    subnets, security group, and an S3 bucket you control; see docs/first-deployment-playbook.md.
  */

  "awsToolsDefaults": {
    "profile": "GovDev",
    "region": "us-gov-west-1",
    "configuration": "Release",
    "s3-prefix": "dev-national-wid-api",
    "stack-name": "dev-national-wid-api",
    "s3-bucket": "TODO_SET_YOUR_DEPLOYMENTS_BUCKET"
  },

  "templates": [
    "cloud-deployment/lambda.template"
  ],

  "templateParameters": {
    "appEnvironment": "dev",
    "appAspNetCoreEnvironment": "Development",
    "appCognitoUserPoolId": "us-gov-west-1_OGMbjPhYh",
    "appCognitoClientId": "1151pibjvfgecq8d761drjcmu8",
    "appCognitoClientIdSecondary": "57k8c86o5fidijcjjnubrsudf5",
    "appAuroraDbName": "nationalwid",
    "appAuroraMinCapacity": 0.5,
    "appAuroraMaxCapacity": 8,

    "vpcId": "TODO_SET_YOUR_VPC_ID",
    "vpcSubnetIds": "TODO_SET_YOUR_SUBNET_IDS",
    "vpcSecurityGroupIds": "TODO_SET_YOUR_SECURITY_GROUP_IDS",

    "tagElcid": "wsitapro",
    "tagDept": "dws",
    "tagDivision": "wra",
    "tagContact": "MattSteadman@utah.gov",
    "tagEnv": "dev",

    "appCorsOrigin1": "https://dev.ulmita.org",
    "appCorsOrigin2": "https://ulmita.org",
    "appCorsOrigin3": "http://localhost:4200",
    "appCorsOrigin4": "https://localhost:4200"
  }
}
